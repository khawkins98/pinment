{
  "manifest_version": 3,
  "name": "Pinment",
  "version": "1.2.0",
  "description": "Visual feedback and annotations for any webpage.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Annotate page with Pinment",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
